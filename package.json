{
  "name": "nexstay-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "mobile": "turbo run dev --filter=@nexstay/mobile",
    "dashboard": "turbo run dev --filter=@nexstay/dashboard",
    "backend": "turbo run dev --filter=@nexstay/backend",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.4.5",
    "expo": "~54.0.13",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "version": "1.0.0"
}
