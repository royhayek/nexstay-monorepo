# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the appropriate values for your environment

# ==============================================
# API Configuration
# ==============================================
EXPO_PUBLIC_API_URL=https://api.nexstay.com/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_API_VERSION=v1

# ==============================================
# App Configuration
# ==============================================
EXPO_PUBLIC_APP_NAME=Homestay
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development

# ==============================================
# Feature Flags
# ==============================================
EXPO_PUBLIC_ENABLE_DEBUG_MODE=true
EXPO_PUBLIC_ENABLE_LOGGING=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# ==============================================
# Third-party Services
# ==============================================
# Google Maps API Key
# Get from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Firebase Configuration (if using Firebase)
# Get from: https://console.firebase.google.com/
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Stripe Configuration (if using Stripe for payments)
# Get from: https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key-here

# ==============================================
# Analytics & Monitoring
# ==============================================
# Sentry DSN (if using Sentry for error tracking)
# Get from: https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# ==============================================
# Storage & CDN
# ==============================================
# AWS S3 Bucket for file uploads
EXPO_PUBLIC_AWS_S3_BUCKET=nexstay-uploads
# CDN URL for serving static assets
EXPO_PUBLIC_CDN_URL=https://cdn.nexstay.com

# ==============================================
# Social Authentication (if using OAuth)
# ==============================================
# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook App ID
# Get from: https://developers.facebook.com/apps/
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ==============================================
# Deep Linking
# ==============================================
# Custom URL scheme for deep linking
EXPO_PUBLIC_APP_SCHEME=nexstay

# ==============================================
# Development Only
# ==============================================
# Only needed for development/debugging
# EXPO_PUBLIC_DEBUG_API_CALLS=true
# EXPO_PUBLIC_MOCK_API=false