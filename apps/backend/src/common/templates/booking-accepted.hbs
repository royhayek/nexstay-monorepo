<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Booking Accepted - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">🎉</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">Your Booking is Confirmed!</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">Get ready for your upcoming stay</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{guestName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        Great news! Your booking request has been <strong>accepted</strong> by the host. Your reservation is now confirmed and you're all set for your stay.
      </p>

      <!-- Booking Details Card -->
      <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 12px; padding: 24px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h2 style="margin: 0 0 20px; font-size: 20px; font-weight: 600; color: #059669;">Booking Details</h2>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Property</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{propertyName}}</div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Check-in</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkInDate}}</div>
          </div>
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Check-out</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkOutDate}}</div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Nights</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{nights}}</div>
          </div>
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Guests</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{totalGuests}}</div>
          </div>
        </div>

        <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #d1fae5;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Confirmation Code</div>
          <div style="font-size: 20px; font-weight: 700; color: #059669; letter-spacing: 2px;">{{confirmationCode}}</div>
        </div>
      </div>

      <!-- Payment Information -->
      <div style="background-color: #f9fafb; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1f2937;">Payment Summary</h3>
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span style="color: #6b7280;">Total Amount</span>
          <span style="font-weight: 600; color: #1f2937;">{{totalAmount}} {{currency}}</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-top: 12px; padding-top: 12px; border-top: 1px solid #e5e7eb;">
          <span style="color: #6b7280;">Payment Status</span>
          <span style="color: #10b981; font-weight: 600;">✓ {{paymentStatus}}</span>
        </div>
      </div>

      <!-- Next Steps -->
      <div style="background-color: #eff6ff; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1e40af;">What's Next?</h3>
        <ul style="margin: 0; padding-left: 20px; color: #374151;">
          <li style="margin-bottom: 8px;">You'll receive check-in instructions closer to your arrival date</li>
          <li style="margin-bottom: 8px;">Contact your host if you have any questions about the property</li>
          <li style="margin-bottom: 8px;">Review the house rules and property details before your stay</li>
          <li>We'll send you a reminder 24 hours before check-in</li>
        </ul>
      </div>

      {{#if hostMessage}}
      <!-- Host Message -->
      <div style="background-color: #fefce8; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #eab308;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #854d0e;">Message from Your Host</h3>
        <p style="margin: 0; color: #713f12; font-style: italic; line-height: 1.6;">"{{hostMessage}}"</p>
      </div>
      {{/if}}

      <!-- CTA Buttons -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{bookingDetailsUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 8px;">
          View Booking Details
        </a>
        <a href="{{contactHostUrl}}" style="display: inline-block; background-color: #ffffff; color: #667eea; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; border: 2px solid #667eea; margin: 8px;">
          Contact Host
        </a>
      </div>

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center;">
        Need help? Contact our support team at <a href="mailto:{{supportEmail}}" style="color: #667eea; text-decoration: none;">{{supportEmail}}</a>
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{guestEmail}}
      </p>
    </div>

  </div>
</body>
</html>
