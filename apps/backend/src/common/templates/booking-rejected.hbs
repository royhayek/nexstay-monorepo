<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Booking Request Update - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">Booking Request Update</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">Your booking request status has changed</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{guestName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        Unfortunately, your booking request for <strong>{{propertyName}}</strong> could not be accepted by the host at this time.
      </p>

      <!-- Booking Details Card -->
      <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 12px; padding: 24px; margin: 24px 0; border-left: 4px solid #f59e0b;">
        <h2 style="margin: 0 0 20px; font-size: 20px; font-weight: 600; color: #92400e;">Request Details</h2>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Property</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{propertyName}}</div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Check-in</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkInDate}}</div>
          </div>
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Check-out</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkOutDate}}</div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Nights</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{nights}}</div>
          </div>
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Guests</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{totalGuests}}</div>
          </div>
        </div>

        <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #fde68a;">
          <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Request ID</div>
          <div style="font-size: 18px; font-weight: 700; color: #92400e; letter-spacing: 1px;">{{requestId}}</div>
        </div>
      </div>

      {{#if hostMessage}}
      <!-- Host Message -->
      <div style="background-color: #fef2f2; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #ef4444;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #991b1b;">Message from Host</h3>
        <p style="margin: 0; color: #7f1d1d; font-style: italic; line-height: 1.6;">"{{hostMessage}}"</p>
      </div>
      {{/if}}

      <!-- Refund Information (if applicable) -->
      {{#if refundAmount}}
      <div style="background-color: #f0fdf4; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #065f46;">Refund Information</h3>
        <p style="margin: 0 0 12px; color: #047857; line-height: 1.6;">
          Since payment was already processed, a full refund of <strong>{{refundAmount}} {{currency}}</strong> will be issued to your original payment method within 5-7 business days.
        </p>
      </div>
      {{/if}}

      <!-- Alternative Options -->
      <div style="background-color: #eff6ff; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1e40af;">Don't Worry - We Have Options!</h3>
        <p style="margin: 0 0 16px; color: #374151; line-height: 1.6;">
          While this property isn't available, we have many other great options for your dates:
        </p>
        <ul style="margin: 0; padding-left: 20px; color: #374151;">
          <li style="margin-bottom: 8px;">Browse similar properties in the same area</li>
          <li style="margin-bottom: 8px;">Adjust your dates to find more availability</li>
          <li style="margin-bottom: 8px;">Contact our support team for personalized recommendations</li>
        </ul>
      </div>

      <!-- CTA Buttons -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{searchSimilarUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 8px;">
          Search Similar Properties
        </a>
        <a href="{{viewAllPropertiesUrl}}" style="display: inline-block; background-color: #ffffff; color: #667eea; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; border: 2px solid #667eea; margin: 8px;">
          View All Properties
        </a>
      </div>

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center;">
        Need assistance finding the perfect place? Contact us at <a href="mailto:{{supportEmail}}" style="color: #667eea; text-decoration: none;">{{supportEmail}}</a>
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{guestEmail}}
      </p>
    </div>

  </div>
</body>
</html>
