<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>New Message - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">💬</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">You Have a New Message</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">Someone is trying to reach you</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{recipientName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        <strong>{{senderName}}</strong> sent you a message{{#if propertyName}} about <strong>{{propertyName}}</strong>{{/if}}.
      </p>

      <!-- Sender Info Card -->
      <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-radius: 12px; padding: 24px; margin: 24px 0; border-left: 4px solid #667eea;">
        <div style="display: flex; align-items: center; margin-bottom: 16px;">
          {{#if senderAvatar}}
          <img src="{{senderAvatar}}" alt="{{senderName}}" style="width: 64px; height: 64px; border-radius: 50%; margin-right: 16px; object-fit: cover;" />
          {{else}}
          <div style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; margin-right: 16px; color: white; font-size: 24px; font-weight: 700;">
            {{senderInitials}}
          </div>
          {{/if}}
          <div>
            <div style="font-size: 18px; font-weight: 600; color: #1f2937; margin-bottom: 4px;">{{senderName}}</div>
            {{#if senderRole}}
            <div style="font-size: 14px; color: #6b7280;">{{senderRole}}</div>
            {{/if}}
          </div>
        </div>

        {{#if propertyName}}
        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #bfdbfe;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Regarding Property</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{propertyName}}</div>
        </div>
        {{/if}}

        {{#if bookingId}}
        <div style="margin-top: 12px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Booking</div>
          <div style="font-size: 14px; font-weight: 600; color: #1f2937; font-family: monospace;">{{bookingId}}</div>
        </div>
        {{/if}}
      </div>

      <!-- Message Preview -->
      <div style="background-color: #ffffff; border: 2px solid #e5e7eb; border-radius: 12px; padding: 24px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1f2937;">Message Preview</h3>

        <div style="background-color: #f9fafb; border-left: 4px solid #667eea; padding: 16px; border-radius: 8px;">
          <p style="margin: 0; color: #374151; font-size: 16px; line-height: 1.6; font-style: italic;">
            "{{messagePreview}}"
          </p>
        </div>

        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #e5e7eb; font-size: 14px; color: #6b7280;">
          <div style="display: flex; justify-content: space-between;">
            <span>Sent:</span>
            <span style="font-weight: 600; color: #1f2937;">{{sentAt}}</span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      {{#if isBookingRelated}}
      <div style="background-color: #eff6ff; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #1e40af;">🏠 Booking Related Message</h3>
        <p style="margin: 0; color: #374151; font-size: 14px; line-height: 1.6;">
          This message is related to an active booking. Quick responses help create a better experience for everyone.
        </p>
      </div>
      {{/if}}

      <!-- Response Tips -->
      <div style="background-color: #f0fdf4; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #065f46;">💡 Quick Response Tips</h3>
        <ul style="margin: 0; padding-left: 20px; color: #047857; font-size: 14px;">
          <li style="margin-bottom: 8px;">Respond within 24 hours for the best experience</li>
          <li style="margin-bottom: 8px;">Be friendly and professional</li>
          <li style="margin-bottom: 8px;">Provide clear and helpful information</li>
          <li>Set expectations for availability and response times</li>
        </ul>
      </div>

      <!-- CTA Button -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{messageUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 16px 48px; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 18px; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
          Reply to Message
        </a>
      </div>

      <!-- Notification Settings -->
      <div style="text-align: center; margin: 24px 0;">
        <p style="margin: 0; font-size: 13px; color: #6b7280;">
          <a href="{{notificationSettingsUrl}}" style="color: #667eea; text-decoration: none;">Manage notification preferences</a>
        </p>
      </div>

      <!-- Unread Messages Count -->
      {{#if unreadCount}}
      {{#if (gt unreadCount 1)}}
      <div style="background-color: #fef3c7; border-radius: 8px; padding: 16px; margin: 24px 0; text-align: center; border: 1px solid #fde68a;">
        <p style="margin: 0; color: #92400e; font-size: 14px;">
          <strong>📨 You have {{unreadCount}} unread messages</strong><br/>
          <a href="{{inboxUrl}}" style="color: #92400e; text-decoration: underline; font-weight: 600;">View all messages</a>
        </p>
      </div>
      {{/if}}
      {{/if}}

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center; line-height: 1.6;">
        This message was sent through Nexstay's secure messaging system.<br/>
        Never share personal contact information or payment details via messages.
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        Stay connected with your {{#if isHost}}guests{{else}}hosts{{/if}}!
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{recipientEmail}}
      </p>
    </div>

  </div>
</body>
</html>
