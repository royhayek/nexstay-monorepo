<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>How Was Your Stay? - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">⭐</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">How Was Your Stay?</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">Share your experience with us</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{guestName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        We hope you had a wonderful stay at <strong>{{propertyName}}</strong>! Your feedback is incredibly valuable to us and helps other travelers make informed decisions.
      </p>

      <!-- Stay Summary Card -->
      <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 12px; padding: 24px; margin: 24px 0; border-left: 4px solid #f59e0b;">
        <h2 style="margin: 0 0 20px; font-size: 20px; font-weight: 600; color: #92400e;">Your Stay</h2>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Property</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{propertyName}}</div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Check-in</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkInDate}}</div>
          </div>
          <div style="flex: 1;">
            <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Check-out</div>
            <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{checkOutDate}}</div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <div style="font-size: 14px; color: #78350f; margin-bottom: 4px;">Host</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{hostName}}</div>
        </div>
      </div>

      <!-- Why Reviews Matter -->
      <div style="background-color: #eff6ff; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1e40af;">Why Your Review Matters</h3>
        <ul style="margin: 0; padding-left: 20px; color: #374151;">
          <li style="margin-bottom: 8px;">Help other travelers find great places to stay</li>
          <li style="margin-bottom: 8px;">Give {{hostName}} valuable feedback</li>
          <li style="margin-bottom: 8px;">Help us improve the Nexstay community</li>
          <li>Your honest opinion makes a difference</li>
        </ul>
      </div>

      <!-- Rating Preview -->
      <div style="text-align: center; margin: 32px 0; padding: 24px; background-color: #f9fafb; border-radius: 8px;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1f2937;">Rate Your Experience</h3>
        <div style="font-size: 48px; margin: 16px 0;">
          ⭐ ⭐ ⭐ ⭐ ⭐
        </div>
        <p style="margin: 0; color: #6b7280; font-size: 14px;">It only takes 2 minutes!</p>
      </div>

      <!-- What to Review -->
      <div style="background-color: #f0fdf4; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #065f46;">What to Include in Your Review</h3>
        <div style="color: #047857;">
          <div style="margin-bottom: 12px;">
            <strong>✓ Cleanliness:</strong> Was the property clean and well-maintained?
          </div>
          <div style="margin-bottom: 12px;">
            <strong>✓ Accuracy:</strong> Did the listing match your expectations?
          </div>
          <div style="margin-bottom: 12px;">
            <strong>✓ Check-in:</strong> Was the check-in process smooth?
          </div>
          <div style="margin-bottom: 12px;">
            <strong>✓ Communication:</strong> Was the host responsive and helpful?
          </div>
          <div>
            <strong>✓ Location:</strong> How was the neighborhood and accessibility?
          </div>
        </div>
      </div>

      <!-- CTA Button -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{reviewUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 16px 48px; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 18px; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
          Write Your Review
        </a>
      </div>

      <!-- Review Deadline Notice -->
      {{#if reviewDeadline}}
      <div style="background-color: #fef2f2; border-radius: 8px; padding: 16px; margin: 24px 0; text-align: center; border: 1px solid #fecaca;">
        <p style="margin: 0; color: #991b1b; font-size: 14px;">
          <strong>⏰ Review Deadline:</strong> {{reviewDeadline}}<br/>
          <span style="font-size: 13px;">Reviews must be submitted within 14 days of check-out</span>
        </p>
      </div>
      {{/if}}

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center; line-height: 1.6;">
        Your review will be visible to other guests and to {{hostName}}.<br/>
        Thank you for being part of the Nexstay community!
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        We appreciate your feedback!
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{guestEmail}}
      </p>
    </div>

  </div>
</body>
</html>
