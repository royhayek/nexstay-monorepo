<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Booking Confirmed - {{propertyName}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #00a650 0%, #00d084 100%); color: white; padding: 30px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 8px;">✅</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600;">Booking Confirmed!</h1>
    </div>
    
    <!-- Content -->
    <div style="padding: 32px 24px;">
      <p style="font-size: 18px; margin-bottom: 8px; font-weight: 600;">Hello {{guestName}},</p>
      <p style="font-size: 16px; color: #666; margin-bottom: 24px;">Great news! Your booking has been confirmed.</p>
      
      <!-- Booking Details -->
      <div style="background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%); border: 1px solid #e1e8ff; border-radius: 12px; padding: 24px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px 0; color: #333; font-size: 20px;">Booking Details</h3>
        
        <div style="border-bottom: 1px solid #e1e8ff; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #555;">Property:</strong><br/>
          <span style="font-size: 16px; color: #333;">{{propertyName}}</span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <strong style="color: #555;">Check-in:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkInDate}}</span>
          </div>
          <div style="flex: 1; text-align: right;">
            <strong style="color: #555;">Check-out:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkOutDate}}</span>
          </div>
        </div>
        
        {{#if confirmationCode}}
        <div style="background-color: #fff; border: 2px dashed #667eea; border-radius: 8px; padding: 16px; text-align: center;">
          <strong style="color: #555; font-size: 14px;">Confirmation Code:</strong><br/>
          <span style="font-size: 24px; font-weight: bold; color: #667eea; font-family: monospace;">{{confirmationCode}}</span>
        </div>
        {{/if}}
      </div>
      
      <!-- Host Information -->
      {{#if hostName}}
      <div style="background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #333;">Your Host</h4>
        <p style="margin: 0; font-size: 16px;">{{hostName}} is looking forward to hosting you!</p>
      </div>
      {{/if}}
      
      <!-- Action Button -->
      {{#if actionUrl}}
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px;">
          View Booking Details
        </a>
      </div>
      {{/if}}
      
      <!-- Next Steps -->
      <div style="background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 12px 0; color: #856404;">What's Next?</h4>
        <ul style="margin: 0; padding-left: 20px; color: #856404;">
          <li>Save your confirmation code for check-in</li>
          <li>Review the property details and house rules</li>
          <li>Contact your host if you have any questions</li>
          <li>Get ready for an amazing stay!</li>
        </ul>
      </div>
      
      <p style="color: #666; font-size: 14px; margin-top: 32px;">
        We're excited for your upcoming trip! If you need to make any changes or have questions, 
        please contact us or reach out to your host directly.
      </p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0; color: #666; font-size: 14px;">
        Have a wonderful stay!<br/>
        <strong>The Airbnb Clone Team</strong>
      </p>
    </div>
  </div>
</body>
</html>