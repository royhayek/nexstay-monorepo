<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>New Review Received - {{propertyName}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%); color: white; padding: 30px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 8px;">⭐</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600;">New Review Received!</h1>
      <p style="margin: 8px 0 0 0; font-size: 16px; opacity: 0.9;">Someone shared their experience</p>
    </div>
    
    <!-- Content -->
    <div style="padding: 32px 24px;">
      <p style="font-size: 18px; margin-bottom: 8px; font-weight: 600;">Hello {{hostName}},</p>
      <p style="font-size: 16px; color: #666; margin-bottom: 24px;">
        Great news! You've received a new review from a recent guest. Here's what they had to say about their stay.
      </p>
      
      <!-- Review Details -->
      <div style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-radius: 12px; padding: 24px; margin: 24px 0;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <h3 style="margin: 0; color: #7c3aed; font-size: 20px;">Review Details</h3>
          {{#if rating}}
          <div style="display: flex; align-items: center;">
            {{#each stars}}
            <span style="color: #fbbf24; font-size: 20px; margin-right: 2px;">⭐</span>
            {{/each}}
            <span style="margin-left: 8px; font-weight: bold; color: #7c3aed;">{{rating}}/5</span>
          </div>
          {{/if}}
        </div>
        
        <div style="border-bottom: 1px solid #d8b4fe; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #7c3aed;">Property:</strong><br/>
          <span style="font-size: 16px; color: #581c87;">{{propertyName}}</span>
        </div>
        
        <div style="border-bottom: 1px solid #d8b4fe; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #7c3aed;">Guest:</strong><br/>
          <span style="font-size: 16px; color: #581c87;">{{guestName}}</span>
        </div>
        
        {{#if reviewText}}
        <div style="background-color: #fff; border-left: 4px solid #8b5cf6; padding: 20px; border-radius: 4px;">
          <strong style="color: #7c3aed; margin-bottom: 8px; display: block;">What they said:</strong>
          <p style="margin: 0; font-size: 16px; color: #374151; font-style: italic; line-height: 1.7;">
            "{{reviewText}}"
          </p>
        </div>
        {{/if}}
      </div>
      
      <!-- Rating Breakdown (if available) -->
      {{#if ratingBreakdown}}
      <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 16px 0; color: #374151;">📊 Rating Breakdown</h4>
        {{#each ratingBreakdown}}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #4b5563;">{{category}}</span>
          <div style="display: flex; align-items: center;">
            <div style="width: 100px; height: 6px; background-color: #e5e7eb; border-radius: 3px; margin-right: 8px;">
              <div style="width: {{percentage}}%; height: 100%; background-color: #fbbf24; border-radius: 3px;"></div>
            </div>
            <span style="color: #374151; font-weight: bold;">{{score}}</span>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      
      <!-- Response Encouragement -->
      <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #047857;">💬 Consider Responding</h4>
        <p style="margin: 0; color: #047857;">
          Thank your guest for their review! Responding to reviews shows future guests that you care about their experience and helps build trust in your listing.
        </p>
      </div>
      
      <!-- Action Buttons -->
      {{#if actionUrl}}
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 0 8px;">
          View Review
        </a>
        <a href="{{actionUrl}}/respond" style="display: inline-block; background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 0 8px;">
          Respond to Review
        </a>
      </div>
      {{/if}}
      
      <!-- Review Tips -->
      <div style="background-color: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 12px 0; color: #92400e;">💡 Review Response Tips</h4>
        <ul style="margin: 0; padding-left: 20px; color: #92400e;">
          <li>Thank the guest for their feedback</li>
          <li>Address any specific points they mentioned</li>
          <li>Keep your response professional and friendly</li>
          <li>Show that you value their experience</li>
          <li>Invite them back in the future</li>
        </ul>
      </div>
      
      <!-- Stats Update -->
      {{#if overallRating}}
      <div style="background-color: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 20px; margin: 24px 0; text-align: center;">
        <h4 style="margin: 0 0 8px 0; color: #0369a1;">📈 Your Updated Rating</h4>
        <p style="margin: 0; color: #0369a1;">
          Your property now has an overall rating of <strong>{{overallRating}}/5</strong> 
          {{#if totalReviews}}based on {{totalReviews}} reviews{{/if}}
        </p>
      </div>
      {{/if}}
      
      <p style="color: #666; font-size: 14px; margin-top: 32px; text-align: center;">
        Keep up the great work! Positive reviews like this help your listing stand out and attract more guests.
      </p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0; color: #666; font-size: 14px;">
        Congratulations on the review!<br/>
        <strong>The Airbnb Clone Team</strong>
      </p>
    </div>
  </div>
</body>
</html>