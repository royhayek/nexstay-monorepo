<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Booking Cancelled - {{propertyName}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%); color: white; padding: 30px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 8px;">❌</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600;">Booking Cancelled</h1>
    </div>
    
    <!-- Content -->
    <div style="padding: 32px 24px;">
      <p style="font-size: 18px; margin-bottom: 8px; font-weight: 600;">Hello {{recipientName}},</p>
      <p style="font-size: 16px; color: #666; margin-bottom: 24px;">We're writing to inform you that a booking has been cancelled.</p>
      
      <!-- Cancellation Details -->
      <div style="background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%); border: 1px solid #d1d5db; border-radius: 12px; padding: 24px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px 0; color: #333; font-size: 20px;">Cancellation Details</h3>
        
        <div style="border-bottom: 1px solid #d1d5db; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #555;">Property:</strong><br/>
          <span style="font-size: 16px; color: #333;">{{propertyName}}</span>
        </div>
        
        <div style="border-bottom: 1px solid #d1d5db; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #555;">Cancelled by:</strong><br/>
          <span style="font-size: 16px; color: #333;">{{senderName}}</span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <strong style="color: #555;">Original Check-in:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkInDate}}</span>
          </div>
          <div style="flex: 1; text-align: right;">
            <strong style="color: #555;">Original Check-out:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkOutDate}}</span>
          </div>
        </div>
        
        {{#if reason}}
        <div style="background-color: #fff; border-left: 4px solid #fbbf24; padding: 16px; border-radius: 4px;">
          <strong style="color: #555;">Reason for cancellation:</strong><br/>
          <span style="font-size: 16px; color: #333; font-style: italic;">"{{reason}}"</span>
        </div>
        {{/if}}
      </div>
      
      <!-- Refund Information -->
      {{#if refundInfo}}
      <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #047857;">💰 Refund Information</h4>
        <p style="margin: 0; color: #047857;">
          {{refundInfo}}
        </p>
      </div>
      {{else}}
      <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #047857;">💰 Refund Information</h4>
        <p style="margin: 0; color: #047857;">
          If you're eligible for a refund, it will be processed according to our cancellation policy. 
          Please allow 5-10 business days for the refund to appear in your account.
        </p>
      </div>
      {{/if}}
      
      <!-- Action Button -->
      {{#if actionUrl}}
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px;">
          View Cancellation Details
        </a>
      </div>
      {{/if}}
      
      <!-- Support Information -->
      <div style="background-color: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #92400e;">🤝 Need Help?</h4>
        <p style="margin: 0; color: #92400e;">
          We understand that cancellations can be disappointing. Our support team is here to help you find alternative accommodations or answer any questions you may have.
        </p>
      </div>
      
      <p style="color: #666; font-size: 14px; margin-top: 32px;">
        We apologize for any inconvenience this cancellation may have caused. 
        If you have any questions or need assistance, please don't hesitate to contact our support team.
      </p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0; color: #666; font-size: 14px;">
        We're here to help!<br/>
        <strong>The Airbnb Clone Team</strong>
      </p>
    </div>
  </div>
</body>
</html>