<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Payout Processed - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">💰</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">Payout Processed!</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">Your earnings are on the way</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{hostName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        Great news! Your payout has been processed successfully. The funds should appear in your account within {{transferTime}}.
      </p>

      <!-- Payout Summary Card -->
      <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 12px; padding: 24px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h2 style="margin: 0 0 20px; font-size: 20px; font-weight: 600; color: #059669;">Payout Details</h2>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Payout ID</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937; font-family: monospace;">{{payoutId}}</div>
        </div>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Processing Date</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{payoutDate}}</div>
        </div>

        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Expected Arrival</div>
          <div style="font-size: 16px; font-weight: 600; color: #1f2937;">{{expectedArrival}}</div>
        </div>

        <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #d1fae5;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">Amount</div>
          <div style="font-size: 28px; font-weight: 700; color: #059669;">{{currency}} {{amount}}</div>
        </div>
      </div>

      <!-- Payment Method -->
      <div style="background-color: #f9fafb; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1f2937;">Payment Method</h3>

        <div style="display: flex; align-items: center; padding: 16px; background-color: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb;">
          <div style="font-size: 32px; margin-right: 16px;">🏦</div>
          <div style="flex: 1;">
            <div style="font-weight: 600; color: #1f2937; margin-bottom: 4px;">{{paymentMethodType}}</div>
            <div style="font-size: 14px; color: #6b7280;">{{paymentMethodDetails}}</div>
          </div>
        </div>
      </div>

      <!-- Earnings Breakdown -->
      <div style="background-color: #ffffff; border: 2px solid #e5e7eb; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #1f2937;">Earnings Breakdown</h3>

        {{#if bookings}}
        <div style="margin-bottom: 16px;">
          <div style="font-size: 14px; color: #6b7280; margin-bottom: 8px; font-weight: 600;">Included Bookings:</div>
          {{#each bookings}}
          <div style="display: flex; justify-content: space-between; padding: 8px; background-color: #f9fafb; margin-bottom: 8px; border-radius: 4px;">
            <div>
              <div style="font-size: 14px; color: #1f2937; font-weight: 600;">{{propertyName}}</div>
              <div style="font-size: 12px; color: #6b7280;">{{checkInDate}} - {{checkOutDate}}</div>
            </div>
            <div style="font-weight: 600; color: #1f2937;">{{currency}} {{amount}}</div>
          </div>
          {{/each}}
        </div>
        {{/if}}

        <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
          <span style="color: #6b7280;">Gross Earnings</span>
          <span style="font-weight: 600; color: #1f2937;">{{currency}} {{grossEarnings}}</span>
        </div>

        {{#if serviceFee}}
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
          <span style="color: #6b7280;">Service Fee</span>
          <span style="font-weight: 600; color: #dc2626;">- {{currency}} {{serviceFee}}</span>
        </div>
        {{/if}}

        {{#if taxes}}
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
          <span style="color: #6b7280;">Taxes Withheld</span>
          <span style="font-weight: 600; color: #dc2626;">- {{currency}} {{taxes}}</span>
        </div>
        {{/if}}

        {{#if adjustments}}
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
          <span style="color: #6b7280;">Adjustments</span>
          <span style="font-weight: 600; color: #1f2937;">{{currency}} {{adjustments}}</span>
        </div>
        {{/if}}

        <div style="border-top: 2px solid #e5e7eb; margin: 16px 0; padding-top: 16px;">
          <div style="display: flex; justify-content: space-between;">
            <span style="font-size: 18px; font-weight: 700; color: #1f2937;">Net Payout</span>
            <span style="font-size: 20px; font-weight: 700; color: #10b981;">{{currency}} {{amount}}</span>
          </div>
        </div>
      </div>

      <!-- Important Information -->
      <div style="background-color: #eff6ff; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #1e40af;">📋 Important Information</h3>
        <ul style="margin: 0; padding-left: 20px; color: #374151;">
          <li style="margin-bottom: 8px;">Keep this confirmation for your records</li>
          <li style="margin-bottom: 8px;">The transfer time depends on your bank's processing schedule</li>
          <li style="margin-bottom: 8px;">You'll receive a separate tax document for this payout</li>
          <li>Contact support if you don't receive the funds within {{transferTime}}</li>
        </ul>
      </div>

      <!-- CTA Buttons -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{payoutHistoryUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 8px;">
          View Payout History
        </a>
        <a href="{{earningsDashboardUrl}}" style="display: inline-block; background-color: #ffffff; color: #667eea; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; border: 2px solid #667eea; margin: 8px;">
          Earnings Dashboard
        </a>
      </div>

      <!-- Next Payout Info -->
      {{#if nextPayoutDate}}
      <div style="background-color: #fef3c7; border-radius: 8px; padding: 16px; margin: 24px 0; text-align: center; border: 1px solid #fde68a;">
        <p style="margin: 0; color: #92400e; font-size: 14px;">
          <strong>📅 Next Payout:</strong> {{nextPayoutDate}}<br/>
          <span style="font-size: 13px;">Current pending earnings: {{currency}} {{pendingEarnings}}</span>
        </p>
      </div>
      {{/if}}

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center;">
        Questions about this payout? Contact us at <a href="mailto:{{supportEmail}}" style="color: #667eea; text-decoration: none;">{{supportEmail}}</a>
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">
        Thank you for being a valued host!
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{hostEmail}}
      </p>
    </div>

  </div>
</body>
</html>
