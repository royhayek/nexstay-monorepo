<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Welcome to Airbnb Clone!</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 64px; margin-bottom: 16px;">🎉</div>
      <h1 style="margin: 0; font-size: 32px; font-weight: 600;">Welcome to Airbnb Clone!</h1>
      <p style="margin: 8px 0 0 0; font-size: 18px; opacity: 0.9;">Your journey starts here</p>
    </div>
    
    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="font-size: 20px; margin-bottom: 8px; font-weight: 600;">Hello {{userName}},</p>
      <p style="font-size: 16px; color: #666; margin-bottom: 32px;">
        Welcome to our community! We're thrilled to have you on board and can't wait for you to start exploring amazing places and experiences.
      </p>
      
      <!-- Getting Started Section -->
      <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-radius: 12px; padding: 32px 24px; margin: 32px 0;">
        <h2 style="margin: 0 0 24px 0; color: #0369a1; font-size: 24px; text-align: center;">🚀 Let's Get Started!</h2>
        
        <div style="margin-bottom: 24px;">
          <div style="display: flex; align-items: center; margin-bottom: 16px;">
            <div style="background-color: #0ea5e9; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 16px; font-weight: bold;">1</div>
            <div>
              <h3 style="margin: 0; color: #0369a1; font-size: 18px;">Complete Your Profile</h3>
              <p style="margin: 4px 0 0 0; color: #0284c7; font-size: 14px;">Add a photo and tell us about yourself</p>
            </div>
          </div>
        </div>
        
        <div style="margin-bottom: 24px;">
          <div style="display: flex; align-items: center; margin-bottom: 16px;">
            <div style="background-color: #0ea5e9; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 16px; font-weight: bold;">2</div>
            <div>
              <h3 style="margin: 0; color: #0369a1; font-size: 18px;">Explore Properties</h3>
              <p style="margin: 4px 0 0 0; color: #0284c7; font-size: 14px;">Browse thousands of unique places to stay</p>
            </div>
          </div>
        </div>
        
        <div style="margin-bottom: 24px;">
          <div style="display: flex; align-items: center; margin-bottom: 16px;">
            <div style="background-color: #0ea5e9; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 16px; font-weight: bold;">3</div>
            <div>
              <h3 style="margin: 0; color: #0369a1; font-size: 18px;">Book Your First Stay</h3>
              <p style="margin: 4px 0 0 0; color: #0284c7; font-size: 14px;">Start your adventure with confidence</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Features Highlight -->
      <div style="margin: 32px 0;">
        <h3 style="text-align: center; color: #333; font-size: 22px; margin-bottom: 24px;">What Makes Us Special</h3>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="text-align: center; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
            <div style="font-size: 32px; margin-bottom: 8px;">🏠</div>
            <h4 style="margin: 0 0 8px 0; color: #333; font-size: 16px;">Unique Properties</h4>
            <p style="margin: 0; color: #666; font-size: 14px;">From cozy apartments to luxury villas</p>
          </div>
          
          <div style="text-align: center; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
            <div style="font-size: 32px; margin-bottom: 8px;">⭐</div>
            <h4 style="margin: 0 0 8px 0; color: #333; font-size: 16px;">Verified Reviews</h4>
            <p style="margin: 0; color: #666; font-size: 14px;">Real reviews from real guests</p>
          </div>
          
          <div style="text-align: center; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
            <div style="font-size: 32px; margin-bottom: 8px;">🔒</div>
            <h4 style="margin: 0 0 8px 0; color: #333; font-size: 16px;">Secure Booking</h4>
            <p style="margin: 0; color: #666; font-size: 14px;">Your payments are protected</p>
          </div>
          
          <div style="text-align: center; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
            <div style="font-size: 32px; margin-bottom: 8px;">🎧</div>
            <h4 style="margin: 0 0 8px 0; color: #333; font-size: 16px;">24/7 Support</h4>
            <p style="margin: 0; color: #666; font-size: 14px;">We're here when you need us</p>
          </div>
        </div>
      </div>
      
      <!-- Call to Action -->
      {{#if actionUrl}}
      <div style="text-align: center; margin: 40px 0;">
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; padding: 18px 36px; border-radius: 12px; font-weight: 600; font-size: 18px; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
          Start Exploring
        </a>
      </div>
      {{/if}}
      
      <!-- Host Invitation -->
      <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 12px; padding: 24px; margin: 32px 0; text-align: center;">
        <h3 style="margin: 0 0 12px 0; color: #92400e; font-size: 20px;">💰 Become a Host</h3>
        <p style="margin: 0; color: #92400e; font-size: 16px;">
          Have an extra room or property? Start earning by hosting travelers from around the world. 
          It's easier than you think!
        </p>
      </div>
      
      <p style="color: #666; font-size: 14px; margin-top: 32px; text-align: center;">
        Thank you for choosing us for your travel adventures. We're committed to making every stay memorable and every host successful.
      </p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 12px 0; color: #666; font-size: 16px;">
        Welcome aboard!<br/>
        <strong>The Airbnb Clone Team</strong>
      </p>
      <p style="margin: 0; color: #999; font-size: 12px;">
        © 2024 Airbnb Clone. All rights reserved.
      </p>
    </div>
  </div>
  
  <!-- Mobile Responsive -->
  <style>
    @media (max-width: 600px) {
      .grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</body>
</html>