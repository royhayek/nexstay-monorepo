<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Reset Your Password - Nexstay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">

    <!-- Header -->
    <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; padding: 40px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 16px;">🔐</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600; line-height: 1.2;">Reset Your Password</h1>
      <p style="margin: 12px 0 0; font-size: 16px; opacity: 0.95;">We received a request to reset your password</p>
    </div>

    <!-- Content -->
    <div style="padding: 40px 24px;">
      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">Hello <strong>{{userName}}</strong>,</p>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6;">
        Someone requested a password reset for your Nexstay account. If this was you, click the button below to reset your password. If you didn't make this request, you can safely ignore this email.
      </p>

      <!-- Security Notice -->
      <div style="background-color: #fef2f2; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #ef4444;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #991b1b;">⚠️ Security Notice</h3>
        <p style="margin: 0; color: #7f1d1d; font-size: 14px; line-height: 1.6;">
          This password reset link will expire in <strong>{{expiryTime}}</strong> for your security. If you need a new link after expiration, you'll need to submit another password reset request.
        </p>
      </div>

      <!-- Reset Button -->
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{resetUrl}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 16px 48px; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 18px; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
          Reset My Password
        </a>
      </div>

      <!-- Alternate Link Section -->
      <div style="background-color: #f9fafb; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <p style="margin: 0 0 12px; font-size: 14px; color: #6b7280; text-align: center;">
          If the button above doesn't work, copy and paste this link into your browser:
        </p>
        <div style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; word-break: break-all; font-family: monospace; font-size: 12px; color: #374151; text-align: center;">
          {{resetUrl}}
        </div>
      </div>

      <!-- Request Details -->
      <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #3b82f6;">
        <h3 style="margin: 0 0 16px; font-size: 16px; font-weight: 600; color: #1e40af;">Request Information</h3>
        <div style="font-size: 14px; color: #374151;">
          <div style="margin-bottom: 8px;">
            <strong>Time:</strong> {{requestTime}}
          </div>
          {{#if ipAddress}}
          <div style="margin-bottom: 8px;">
            <strong>IP Address:</strong> {{ipAddress}}
          </div>
          {{/if}}
          {{#if location}}
          <div style="margin-bottom: 8px;">
            <strong>Location:</strong> {{location}}
          </div>
          {{/if}}
          {{#if device}}
          <div>
            <strong>Device:</strong> {{device}}
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Didn't Request This -->
      <div style="background-color: #f0fdf4; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #10b981;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #065f46;">Didn't Request This?</h3>
        <p style="margin: 0; color: #047857; font-size: 14px; line-height: 1.6;">
          If you didn't request a password reset, please ignore this email. Your password will remain unchanged. However, if you're concerned about your account security, we recommend:
        </p>
        <ul style="margin: 12px 0 0; padding-left: 20px; color: #047857; font-size: 14px;">
          <li style="margin-bottom: 8px;">Change your password immediately</li>
          <li style="margin-bottom: 8px;">Review your recent account activity</li>
          <li>Contact our support team if you notice anything suspicious</li>
        </ul>
      </div>

      <!-- Password Tips -->
      <div style="background-color: #fef3c7; border-radius: 8px; padding: 20px; margin: 24px 0; border-left: 4px solid #f59e0b;">
        <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #92400e;">💡 Password Tips</h3>
        <ul style="margin: 0; padding-left: 20px; color: #78350f; font-size: 14px;">
          <li style="margin-bottom: 8px;">Use at least 8 characters</li>
          <li style="margin-bottom: 8px;">Include uppercase and lowercase letters</li>
          <li style="margin-bottom: 8px;">Add numbers and special characters</li>
          <li style="margin-bottom: 8px;">Avoid common words or personal information</li>
          <li>Don't reuse passwords from other accounts</li>
        </ul>
      </div>

      <!-- Expiry Warning -->
      <div style="text-align: center; margin: 24px 0; padding: 16px; background-color: #fef2f2; border-radius: 8px; border: 1px solid #fecaca;">
        <p style="margin: 0; color: #991b1b; font-size: 14px;">
          <strong>⏰ This link expires in {{expiryTime}}</strong><br/>
          <span style="font-size: 13px;">After that, you'll need to request a new password reset</span>
        </p>
      </div>

      <p style="margin: 24px 0 0; font-size: 14px; color: #6b7280; text-align: center; line-height: 1.6;">
        Need help? Contact our support team at<br/>
        <a href="mailto:{{supportEmail}}" style="color: #667eea; text-decoration: none; font-weight: 600;">{{supportEmail}}</a>
      </p>
    </div>

    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 32px 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0 0 12px; font-size: 14px; color: #6b7280;">
        <strong>Security Reminder:</strong> Nexstay will never ask for your password via email.
      </p>
      <p style="margin: 12px 0 0; font-size: 12px; color: #9ca3af;">
        © 2024 Nexstay. All rights reserved.
      </p>
      <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af;">
        This email was sent to {{userEmail}}
      </p>
    </div>

  </div>
</body>
</html>
