<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>New Booking Request - {{propertyName}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f5f5f5; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); overflow: hidden;">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%); color: white; padding: 30px 24px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 8px;">🏠</div>
      <h1 style="margin: 0; font-size: 28px; font-weight: 600;">New Booking Request</h1>
    </div>
    
    <!-- Content -->
    <div style="padding: 32px 24px;">
      <p style="font-size: 18px; margin-bottom: 8px; font-weight: 600;">Hello {{hostName}},</p>
      <p style="font-size: 16px; color: #666; margin-bottom: 24px;">You have received a new booking request for your property!</p>
      
      <!-- Booking Request Details -->
      <div style="background: linear-gradient(135deg, #fff5f5 0%, #fef2f2 100%); border: 1px solid #fecaca; border-radius: 12px; padding: 24px; margin: 24px 0;">
        <h3 style="margin: 0 0 16px 0; color: #333; font-size: 20px;">Request Details</h3>
        
        <div style="border-bottom: 1px solid #fecaca; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #555;">Property:</strong><br/>
          <span style="font-size: 16px; color: #333;">{{propertyName}}</span>
        </div>
        
        <div style="border-bottom: 1px solid #fecaca; padding-bottom: 16px; margin-bottom: 16px;">
          <strong style="color: #555;">Guest:</strong><br/>
          <span style="font-size: 16px; color: #333;">{{guestName}}</span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <div style="flex: 1;">
            <strong style="color: #555;">Check-in:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkInDate}}</span>
          </div>
          <div style="flex: 1; text-align: right;">
            <strong style="color: #555;">Check-out:</strong><br/>
            <span style="font-size: 16px; color: #333;">{{checkOutDate}}</span>
          </div>
        </div>
        
        {{#if totalAmount}}
        <div style="background-color: #fff; border: 1px solid #d1fae5; border-radius: 8px; padding: 16px; text-align: center;">
          <strong style="color: #555; font-size: 14px;">Total Amount:</strong><br/>
          <span style="font-size: 24px; font-weight: bold; color: #059669;">{{currency}}{{totalAmount}}</span>
        </div>
        {{/if}}
      </div>
      
      <!-- Urgency Notice -->
      <div style="background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 8px 0; color: #856404;">⏰ Action Required</h4>
        <p style="margin: 0; color: #856404;">
          Please respond to this booking request as soon as possible. Guests are waiting for your confirmation!
        </p>
      </div>
      
      <!-- Action Buttons -->
      {{#if actionUrl}}
      <div style="text-align: center; margin: 32px 0;">
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #00a650 0%, #00d084 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 0 8px;">
          Accept Request
        </a>
        <a href="{{actionUrl}}" style="display: inline-block; background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 0 8px;">
          View Details
        </a>
      </div>
      {{/if}}
      
      <!-- Tips for Hosts -->
      <div style="background-color: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 20px; margin: 24px 0;">
        <h4 style="margin: 0 0 12px 0; color: #0369a1;">💡 Host Tips</h4>
        <ul style="margin: 0; padding-left: 20px; color: #0369a1;">
          <li>Review the guest's profile and previous reviews</li>
          <li>Check your calendar for any conflicts</li>
          <li>Respond within 24 hours for the best guest experience</li>
          <li>Ask any questions about their stay if needed</li>
        </ul>
      </div>
      
      <p style="color: #666; font-size: 14px; margin-top: 32px;">
        Remember, quick responses lead to better guest satisfaction and more positive reviews. 
        We're here to help if you have any questions about this request.
      </p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #f8f9fa; padding: 24px; text-align: center; border-top: 1px solid #e9ecef;">
      <p style="margin: 0; color: #666; font-size: 14px;">
        Happy hosting!<br/>
        <strong>The Airbnb Clone Team</strong>
      </p>
    </div>
  </div>
</body>
</html>