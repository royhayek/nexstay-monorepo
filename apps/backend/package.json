  "scripts": {
    "prepare": "husky install",
    "seed": "ts-node src/database/seeds/index.ts",
    "migrate": "ts-node src/database/migrations/index.ts",
    "build": "nest build && node copy-assets.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "localstack:up": "docker compose up -d",
    "localstack:down": "docker compose down"
  },
